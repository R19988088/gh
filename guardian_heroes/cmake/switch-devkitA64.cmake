# devkitA64/libnx target; host tools must never resolve inside the target roots.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_VERSION 1)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(REXGLUE_PLATFORM_SWITCH ON CACHE BOOL "Build for Nintendo Switch/libnx")
if(DEFINED ENV{REXGLUE_SWITCH_FFMPEG} AND NOT DEFINED REXGLUE_SWITCH_FFMPEG)
    set(REXGLUE_SWITCH_FFMPEG "$ENV{REXGLUE_SWITCH_FFMPEG}" CACHE PATH
        "Switch-target FFmpeg SDK root")
endif()

if(NOT DEFINED DEVKITPRO)
    if(DEFINED ENV{DEVKITPRO})
        set(DEVKITPRO "$ENV{DEVKITPRO}" CACHE PATH "devkitPro root")
    else()
        set(DEVKITPRO "${CMAKE_CURRENT_LIST_DIR}/../../toolchains/switch-local/devkitpro" CACHE PATH "devkitPro root")
    endif()
endif()
if(DEFINED ENV{DEVKITA64})
    set(DEVKITA64 "$ENV{DEVKITA64}" CACHE PATH "devkitA64 root")
else()
    set(DEVKITA64 "${DEVKITPRO}/devkitA64" CACHE PATH "devkitA64 root")
endif()
if(NOT EXISTS "${DEVKITA64}/bin/aarch64-none-elf-g++")
    message(FATAL_ERROR "devkitA64 is missing under ${DEVKITA64}; source toolchains/switch-local/env.sh after installation")
endif()
set(_gh_tool_prefix "${DEVKITA64}/bin/aarch64-none-elf-")
if(CMAKE_HOST_WIN32)
    set(_gh_tool_suffix ".exe")
endif()
set(CMAKE_C_COMPILER "${_gh_tool_prefix}gcc${_gh_tool_suffix}")
set(CMAKE_CXX_COMPILER "${_gh_tool_prefix}g++${_gh_tool_suffix}")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_AR "${_gh_tool_prefix}gcc-ar${_gh_tool_suffix}")
set(CMAKE_RANLIB "${_gh_tool_prefix}gcc-ranlib${_gh_tool_suffix}")
set(CMAKE_NM "${_gh_tool_prefix}nm${_gh_tool_suffix}")
set(CMAKE_OBJCOPY "${_gh_tool_prefix}objcopy${_gh_tool_suffix}")
set(CMAKE_STRIP "${_gh_tool_prefix}strip${_gh_tool_suffix}")

set(_gh_arch "-march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -ftls-model=local-exec -fPIE -D__SWITCH__ -DNX -D_GNU_SOURCE")
set(CMAKE_C_FLAGS_INIT "${_gh_arch} -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "${_gh_arch} -ffunction-sections -fdata-sections")
set(CMAKE_ASM_FLAGS_INIT "${_gh_arch}")

# libnx specs normally obtain switch.ld through the DEVKITPRO environment.
# A build-local copy also supports configuring with -DDEVKITPRO alone.
set(_gh_specs_source "${DEVKITPRO}/libnx/switch.specs")
if(NOT EXISTS "${_gh_specs_source}")
    message(FATAL_ERROR "libnx linker specs not found: ${_gh_specs_source}")
endif()
file(READ "${_gh_specs_source}" _gh_specs)
string(REPLACE "%:getenv(DEVKITPRO /libnx/switch.ld)"
    "${DEVKITPRO}/libnx/switch.ld" _gh_specs "${_gh_specs}")
file(WRITE "${CMAKE_BINARY_DIR}/switch.specs" "${_gh_specs}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-specs=${CMAKE_BINARY_DIR}/switch.specs -Wl,--gc-sections -Wl,--no-relax")
set(CMAKE_DL_LIBS "")
# Generic.cmake defines no linker features; devkitA64 uses GNU ld groups.
set(CMAKE_LINK_GROUP_USING_RESCAN "LINKER:--start-group" "LINKER:--end-group")
set(CMAKE_LINK_GROUP_USING_RESCAN_SUPPORTED TRUE)
set(CMAKE_FIND_ROOT_PATH "${DEVKITA64}" "${DEVKITPRO}/libnx" "${DEVKITPRO}/portlibs/switch")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES DEVKITPRO DEVKITA64)
